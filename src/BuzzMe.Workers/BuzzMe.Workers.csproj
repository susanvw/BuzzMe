<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-BuzzMe.Workers-01416680-2fb3-431b-92b9-f8c26d6a1592</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets tests call BuzzDeliveryWorker's internal ProcessBatchAsync directly, bypassing
         the PeriodicTimer loop — same pattern as Domain's Rehydrate factories. -->
    <InternalsVisibleTo Include="BuzzMe.Infrastructure.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuzzMe.Application\BuzzMe.Application.csproj" />
    <ProjectReference Include="..\BuzzMe.Infrastructure\BuzzMe.Infrastructure.csproj" />
  </ItemGroup>
</Project>
